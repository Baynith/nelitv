# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# HARAKAPAY_API_KEY: Server-side API Key for HarakaPay Gateway (kept secret on server).
HARAKAPAY_API_KEY="hpk_93b63ba05db51f1963b174570c71762a73541195bdbc5538"

# VITE_SUPABASE_URL: URL of your existing Supabase project (used for Umax TV & NeliTV).
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public Anon Key for your Supabase project.
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# VITE_API_BASE_URL: (Optional) If frontend is deployed on Firebase Hosting and backend runs on Render/Cloud Run/Railway.
# If left empty, requests to /api/payment/* use relative same-origin calls.
VITE_API_BASE_URL=""
